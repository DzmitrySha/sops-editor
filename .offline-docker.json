{
  "offline_cache": "offline-cache",
  "log_dir": "storage/logs",
  "app_name": "sops-editor",
  "compose_online": "docker-compose.yml",
  "compose_offline": "docker-compose.offline.yml",
  "compose_build": [
    "docker-compose.yml",
    "docker-compose.offline.yml"
  ],
  "compose_up_offline": [
    "docker-compose.yml",
    "docker-compose.offline.yml"
  ],
  "compose_up_offline_lab": [
    "docker-compose.yml",
    "docker-compose.offline.yml"
  ],
  "compose_env_file": "docker/.env",
  "compose_env_files": [
    "docker/.env",
    "docker/.env.secrets"
  ],
  "python": {
    "project_dir": "backend",
    "lock_files": [
      "backend/pyproject.toml",
      "backend/uv.lock"
    ]
  },
  "dockerfiles": {
    "backend": "Dockerfile"
  },
  "images": {
    "backend": "ai-sops-edit:local",
    "frontend": "ai-sops-edit:local"
  },
  "build_services": [
    "ai-sops-edit"
  ],
  "docker_images": [
    "python:3.12-slim",
    "ghcr.io/astral-sh/uv:0.13.7",
    "ubuntu:24.04",
    "alpine/git:2.47.2",
    "aquasec/trivy:latest"
  ],
  "debs": {
    "ubuntu_image": "ubuntu:24.04",
    "packages": [
      "ca-certificates",
      "curl",
      "git",
      "gnupg",
      "openssh-client",
      "tini"
    ],
    "extra_repos": []
  },
  "validate": {
    "critical_wheels": [
      { "pattern": "cryptography-*.whl", "label": "cryptography" },
      { "pattern": "fastapi-*.whl", "label": "fastapi" }
    ]
  },
  "trivy": {
    "scanner_image": "aquasec/trivy:latest",
    "db_max_age_days": 7,
    "severity": "HIGH,CRITICAL",
    "scanners": "vuln"
  }
}
