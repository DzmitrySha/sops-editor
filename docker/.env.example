# SOPS Editor — settings (no secrets here).
# Copy to docker/.env and edit.

# Host directory mounted as /workspace. Point it at a git checkout that
# contains SOPS files.
SOPS_EDITOR_WORKSPACE=./workspace

# Host directory mounted read-only as /keys. Put age.txt there for a
# server-side private key. Can be left empty when using the UI key prompt.
SOPS_EDITOR_KEYS=./keys

# Encrypted backups and cloned repositories.
SOPS_EDITOR_DATA=./storage

# Local mode: only loopback. For Traefik use docker-compose.traefik.yml.
SOPS_EDITOR_BIND=127.0.0.1
SOPS_EDITOR_PORT=8787

# Basic auth user. Password goes in docker/.env.secrets.
SOPS_EDITOR_AUTH_USER=sops

# Authentication: basic (default) | header (OIDC proxy) | none.
# header mode trusts an identity header set by a proxy and must never be
# exposed directly.
# SOPS_EDITOR_AUTH_MODE=basic
# SOPS_EDITOR_AUTH_HEADER=X-Forwarded-User
# SOPS_EDITOR_AUTH_TRUSTED_PROXIES=172.18.0.0/16

# Behind the shared Traefik (docker-compose.traefik.yml):
# lab / work:
# SOPS_EDITOR_FQDN=ai-sops-editor-dev.vitebsk.energo.net
# prod k8s HTTPRoute — без -dev: ai-sops-editor.vitebsk.energo.net
# SOPS_EDITOR_TRUST_PROXY=true
# SOPS_EDITOR_COOKIE_SECURE=true

# Git clone/pull/push:
SOPS_EDITOR_ALLOW_GIT_CLONE=true
# SOPS_EDITOR_GIT_ALLOWED_HOSTS=git.example.net,github.com
# SOPS_EDITOR_GIT_USERNAME=oauth2
# SOPS_EDITOR_GIT_AUTHOR_NAME=SOPS Editor
# SOPS_EDITOR_GIT_AUTHOR_EMAIL=ai-sops-editor@example.net

# SSH git: host ~/.ssh is mounted read-only as /ssh. start-windows.cmd
# fills this automatically from %USERPROFILE%\.ssh. Leave empty to mount
# an empty ./.ssh-host (HTTPS token / agent only).
SOPS_EDITOR_HOST_SSH_DIR=
# Host ~/.gitconfig mounted read-only as /gitconfig, used to prefill
# the commit author fields. start-windows.cmd fills it automatically.
SOPS_EDITOR_HOST_GITCONFIG=
# Optional explicit key inside the container; empty = auto-detect
# id_ed25519/id_ecdsa/id_rsa in /ssh.
# SOPS_EDITOR_GIT_SSH_KEY=/ssh/id_ed25519
# SOPS_EDITOR_GIT_SSH_KNOWN_HOSTS=/ssh/known_hosts
# accept-new (default) | yes | no
# SOPS_EDITOR_GIT_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Limits:
# SOPS_EDITOR_MAX_FILE_BYTES=5242880
# SOPS_EDITOR_BACKUP_KEEP=10
# SOPS_EDITOR_SESSION_TTL_SECONDS=28800
# SOPS_EDITOR_LOG_LEVEL=INFO
