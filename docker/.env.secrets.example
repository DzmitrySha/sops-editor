# SOPS Editor — credentials. Copy to docker/.env.secrets.
# This file is gitignored. NEVER commit real values.

# HTTP Basic auth. Set a long random value for any non-loopback deployment.
# Empty value = auth disabled (dangerous; localhost only).
SOPS_EDITOR_AUTH_PASSWORD=

# Optional HTTPS token for git clone/pull/push (GitLab: oauth2, GitHub:
# x-access-token). Keep empty if SSH keys/agent are mounted instead.
SOPS_EDITOR_GIT_TOKEN=
